# Candidate for a SAME-ORIGIN HTTPS staging deployment, not local XAMPP.
# Copy outside the repository, replace placeholders, then run release-preflight.
# Examples intentionally FAIL the gate until real values are configured.
APP_NAME="AI Chat SaaS"
APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=Asia/Tehran
APP_URL=https://app.example.com
FRONTEND_URL=https://app.example.com
API_URL=https://app.example.com/backend/api
WIDGET_SCRIPT_URL=https://app.example.com/widget.js

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ai_chat_saas_staging
DB_USER=chat_application
DB_PASS=REPLACE_WITH_DATABASE_PASSWORD

# Generate three DIFFERENT random secrets. Keep the encryption key with backups.
JWT_SECRET=REPLACE_WITH_INDEPENDENT_RANDOM_JWT_SECRET
APP_ENCRYPTION_KEY=REPLACE_WITH_INDEPENDENT_RANDOM_ENCRYPTION_KEY
SYSTEM_HEARTBEAT_SECRET=REPLACE_WITH_INDEPENDENT_RANDOM_HEARTBEAT_SECRET
JWT_EXPIRATION_SECONDS=3600
JWT_MAX_TTL_SECONDS=86400
JWT_ISSUER=ai-chat-saas
JWT_AUDIENCE=ai-chat-saas-panel
AUTH_COOKIE_NAME=ai_chat_auth
AUTH_CSRF_COOKIE_NAME=ai_chat_csrf
AUTH_IMPERSONATION_COOKIE_NAME=ai_chat_impersonation
AUTH_IMPERSONATION_CSRF_COOKIE_NAME=ai_chat_impersonation_csrf
AUTH_COOKIE_PATH=/
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=Lax
PANEL_ALLOWED_ORIGINS=https://app.example.com
WIDGET_ALLOWED_ORIGINS=
WIDGET_ALLOW_EMPTY_ORIGIN=false

UPLOAD_MAX_BYTES=3145728
UPLOAD_MAX_IMAGE_PIXELS=20000000
UPLOAD_AUDIO_MAX_BYTES=10485760
ANNOUNCEMENT_IMAGE_MAX_BYTES=2097152
# Keep uploads on persistent storage. See README before customizing this root.
UPLOAD_STORAGE_ROOT=
UPLOAD_PUBLIC_URL=https://app.example.com/backend
MESSAGE_EDIT_WINDOW_SECONDS=900
REALTIME_STREAM_DURATION_SECONDS=25
REALTIME_POLL_INTERVAL_MS=750
VISITOR_ONLINE_SECONDS=75
VISITOR_IDLE_SECONDS=300
VISITOR_INVITE_TTL_SECONDS=300
REQUEST_LOG_SLOW_MS=750
SYSTEM_HEARTBEAT_STALE_SECONDS=180
OPERATIONS_HTTP_PROBES_ENABLED=false
FRONTEND_HEALTH_URL=https://app.example.com
ADMIN_LOGIN_LOCK_THRESHOLD=5
ADMIN_LOGIN_LOCK_MINUTES=15
ADMIN_IMPERSONATION_TICKET_SECONDS=120
ADMIN_IMPERSONATION_TTL_MINUTES=30
QA_BROWSER_AUTO_START=false
QA_BROWSER_HEADLESS=true

# No external AI provider is enabled by this template.
OPENAI_API_KEY=
