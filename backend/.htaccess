Options -Indexes

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "no-referrer"
    Header always set X-Permitted-Cross-Domain-Policies "none"
</IfModule>

<FilesMatch "^\.env$|^\.env\..*|composer\.(json|lock)|package(-lock)?\.json|yarn\.lock|pnpm-lock\.yaml|.*\.sql|.*\.log|.*\.bak|.*\.backup|.*\.ini">
    Require all denied
</FilesMatch>

<FilesMatch "\.(php~|swp|dist|old|orig|save)$">
    Require all denied
</FilesMatch>

<IfModule mod_php.c>
    php_flag display_errors Off
</IfModule>