# ==========================================
# Application
# ==========================================
APP_NAME="AI Chat SaaS"
APP_ENV=local
APP_DEBUG=true
APP_TIMEZONE=Asia/Tehran

APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost/ai-chat-saas/backend/api
WIDGET_SCRIPT_URL=http://localhost/ai-chat-saas/widget/dist/widget.js

# ==========================================
# Database
# ==========================================
DB_HOST=localhost
DB_NAME=ai_chat_saas
DB_USER=root
DB_PASS=

# ==========================================
# Authentication
# ==========================================
JWT_SECRET=change_this_to_a_long_random_secret_with_at_least_32_characters
JWT_EXPIRATION_SECONDS=604800
JWT_MAX_TTL_SECONDS=604800
JWT_ISSUER=ai-chat-saas
JWT_AUDIENCE=ai-chat-saas-panel

# ==========================================
# AI provider
# ==========================================
OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE
OPENAI_MODEL=gpt-4.1-mini

# ==========================================
# Uploads
# ==========================================
UPLOAD_MAX_BYTES=3145728
UPLOAD_MAX_IMAGE_PIXELS=20000000
UPLOAD_STORAGE_ROOT=
UPLOAD_PUBLIC_URL=http://localhost/ai-chat-saas/backend
ANNOUNCEMENT_IMAGE_MAX_BYTES=2097152

# ==========================================
# CORS
# Use comma-separated origins when needed.
# ==========================================
PANEL_ALLOWED_ORIGINS=http://localhost:3000
WIDGET_ALLOWED_ORIGINS=
WIDGET_ALLOW_EMPTY_ORIGIN=true

# Production example:
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://app.example.com
# FRONTEND_URL=https://app.example.com
# API_URL=https://api.example.com/api
# WIDGET_SCRIPT_URL=https://cdn.example.com/widget.js
# PANEL_ALLOWED_ORIGINS=https://app.example.com
# WIDGET_ALLOWED_ORIGINS=https://customer-one.com,https://customer-two.com
# WIDGET_ALLOW_EMPTY_ORIGIN=false

# Messaging
MESSAGE_EDIT_WINDOW_SECONDS=900
UPLOAD_AUDIO_MAX_BYTES=10485760

# Messaging phase 6: live visitor presence
VISITOR_ONLINE_SECONDS=75
VISITOR_IDLE_SECONDS=300
VISITOR_INVITE_TTL_SECONDS=300

# Admin Phase 1 - Operations
REQUEST_LOG_SLOW_MS=750
SYSTEM_HEARTBEAT_SECRET=change_this_heartbeat_secret
SYSTEM_HEARTBEAT_STALE_SECONDS=180
OPERATIONS_HTTP_PROBES_ENABLED=false
FRONTEND_HEALTH_URL=http://localhost:3000
